```kotlin
import java.lang.StringBuilder

fun parseReport(text: String): List<List<String>> {
    val rows = mutableListOf<MutableList<String>>()
    var currentRow = mutableListOf<String>()
    val field = StringBuilder()

    var i = 0
    while (i < text.length) {
        val c = text[i]
        when (c) {
            '\t' -> {
                if (!field.isEmpty() || currentRow.isNotEmpty()) {
                    // End of a field
                    currentRow.add(field.toString())
                    field.setLength(0)
                } else {
                    // Empty field
                    currentRow.add("")
                }
            }

            '\n' -> {
                // End of a row
                if (!field.isEmpty() || currentRow.isNotEmpty()) {
                    currentRow.add(field.toString())
                } else if (currentRow.isEmpty() && field.isEmpty()) {
                    // Skip empty line
                }
                rows.add(currentRow)
                currentRow = mutableListOf()
                field.setLength(0)
            }

            '\r' -> {
                // Handle Windows line endings (\r\n)
                if (i + 1 < text.length && text[i + 1] == '\n') {
                    i++ // skip the \n
                }
                if (!field.isEmpty() || currentRow.isNotEmpty()) {
                    currentRow.add(field.toString())
                } else if (currentRow.isEmpty() && field.isEmpty()) {
                    // Skip empty line
                }
                rows.add(currentRow)
                currentRow = mutableListOf()
                field.setLength(0)
            }

            else -> {
                // Regular character
                field.append(c)
            }
        }
        i++
    }

    // Handle last line if file doesn't end with a newline
    if (field.isNotEmpty() || currentRow.isNotEmpty()) {
        currentRow.add(field.toString())
    }
    if (currentRow.isNotEmpty() || rows.isEmpty()) {
        rows.add(currentRow)
    }

    return rows
}
```

This implementation walks through the input character by character, treating tab characters as field separators only when they are not inside a quoted field. It also correctly handles line breaks (`\n`, `\r\n`) to split rows and preserves tabs that appear inside quoted fields.