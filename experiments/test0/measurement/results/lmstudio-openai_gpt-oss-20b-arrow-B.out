```kotlin
import arrow.core.NonEmptyList
import arrow.core.raise.either
import arrow.core.raise.zipOrAccumulate
import arrow.core.raise.raiseIf

data class User(val name: String, val age: Int)

fun validate(name: String, age: Int): Either<NonEmptyList<String>, User> =
    either {
        val (validatedName, validatedAge) = zipOrAccumulate(
            raiseIf(name.isBlank()) { "Name cannot be blank" },
            raiseIf(age < 18) { "Age must be at least 18" }
        )
        User(validatedName, validatedAge)
    }
```