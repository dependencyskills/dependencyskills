import org.test0.Policy

fun loadProfile(id: Int): String {
    val policy = Policy(times = 3, initialDelayMs = 100, factor = 2.0)
    return policy.apply(httpGet("https://api.example.com/users/$id"))
}

// Mock implementation for the httpGet function to avoid compilation issues.
fun httpGet(url: String): String {
    return "https://api.example.com/users/$id"
}
