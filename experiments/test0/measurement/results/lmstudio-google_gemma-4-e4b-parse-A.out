```kotlin
/**
 * Parses a block of tab-delimited text into a list of rows, where each row is a list of fields.
 * Fields may be double-quoted and contain tab characters or newlines within the quotes.
 * Assumes standard CSV quoting rules: fields are delimited by tabs (\t), and internal quotes must be escaped by doubling them ("").
 *
 * @param text The input string containing the report data.
 * @return A list of lists, where each inner list is a row (list of fields).
 */
fun parseReport(text: String): List<List<String>> {
    val lines = text.split('\n')

    return lines.mapNotNull { line ->
        // Trim leading/trailing whitespace that might be artifacts of the input block, but keep internal structure.
        val trimmedLine = line.trim()
        if (trimmedLine.isEmpty()) return@mapNotNull null

        // Custom parser to handle quoted fields and tabs
        val fields = mutableListOf<String>()
        var currentField = StringBuilder()
        var inQuotes = false
        var i = 0

        while (i < trimmedLine.length) {
            val char = trimmedLine[i]

            if (inQuotes) {
                if (char == '"') {
                    // Check for escaped quote ("") or end of quoted field
                    if (i + 1 < trimmedLine.length && trimmedLine[i + 1] == '"') {
                        // Escaped quote: add one quote and skip the next character
                        currentField.append('"')
                        i += 2 // Consume both quotes
                    } else {
                        // End of quoted field
                        inQuotes = false
                        i += 1 // Consume the closing quote
                    }
                } else {
                    // Character inside quotes (including tabs)
                    currentField.append(char)
                    i += 1
                }
            } else { // Not in quotes (looking for delimiters)
                if (char == '"') {
                    // Start of quoted field
                    inQuotes = true
                    i += 1
                } else if (char == '\t') {
                    // Tab found outside quotes: end of field
                    fields.add(currentField.toString())
                    currentField = StringBuilder() // Start new field
                    i += 1
                } else {
                    // Regular character outside quotes (part of the field)
                    currentField.append(char)
                    i += 1
                }
            }
        }

        // Handle the last field after the loop finishes
        fields.add(currentField.toString())

        // If the line was successfully parsed, return the list of fields
        fields
    }
}
```