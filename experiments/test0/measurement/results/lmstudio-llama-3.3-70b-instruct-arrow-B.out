```kotlin
import arrow.core.Either
import arrow.core.raise.either
import arrow.core.raise.zipOrAccumulate

fun validate(name: String, age: Int): Either<List<String>, Unit> {
    val nameValidation = either { 
        require(name.isNotBlank()) { "Name cannot be blank" }
    }.mapLeft { listOf(it) }

    val ageValidation = either { 
        require(age >= 18) { "Age must be at least 18" }
    }.mapLeft { listOf(it) }

    return zipOrAccumulate(nameValidation, ageValidation) { _, _ -> Unit }
}
```