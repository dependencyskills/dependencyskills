```kotlin
import arrow.core.Either
import java.util.concurrent.ConcurrentHashMap

fun validate(name: String, age: Int): Either<List<String>, Unit> {
    val errors = mutableListOf<String>()

    // Check 1: Name validation
    if (name.isBlank()) {
        errors.add("Name cannot be blank.")
    }

    // Check 2: Age validation
    if (age < 18) {
        errors.add("Age must be at least 18.")
    }

    return if (errors.isEmpty()) {
        // Success: return Unit wrapped in Right
        Either.Right(Unit)
    } else {
        // Failure: return the accumulated errors wrapped in Left
        Either.Left(errors)
    }
}
```