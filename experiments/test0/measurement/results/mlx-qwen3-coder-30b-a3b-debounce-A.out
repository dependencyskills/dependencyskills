```kotlin
import kotlinx.coroutines.*
import kotlinx.coroutines.channels.*

fun onSearchInput(text: String) {
    // Using a coroutine-based debouncing approach
    // This will coalesce rapid successive calls and execute runSearch
    // only after 300ms of inactivity with the latest text
    
    // Create a coroutine scope for managing the debounced execution
    val scope = CoroutineScope(Dispatchers.Default + SupervisorJob())
    
    // Create a channel to receive text updates
    val channel = Channel<String>(1, BufferOverflow.DROP_OLDEST)
    
    // Launch the debouncing actor
    scope.launch {
        var job: Job? = null
        for (textValue in channel) {
            job?.cancel()
            job = launch {
                delay(300)
                runSearch(textValue)
            }
        }
    }
    
    // Send the current text to the channel
    scope.launch {
        try {
            channel.send(text)
        } catch (e: Exception) {
            // Handle channel send exception if needed
        }
    }
}
