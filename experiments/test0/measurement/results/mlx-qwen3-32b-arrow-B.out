```kotlin
import arrow.core.raise.either
import arrow.core.raise.zipOrAccumulate
import arrow.core.Either
import arrow.core.NonEmptyList
import arrow.core.Validated
import arrow.core.invalidNel
import arrow.core.validNel

fun validate(name: String, age: Int): Either<NonEmptyList<String>, Unit> =
    either {
        zipOrAccumulate(
            checkNotBlank(name),
            checkMinimumAge(age)
        ).discard()
    }

private fun checkNotBlank(name: String) =
    either {
        if (name.isNotBlank()) Unit else raise("Name must not be blank")
    }

private fun checkMinimumAge(age: Int) =
    either {
        if (age >= 18) Unit else raise("Age must be at least 18")
    }
```