<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Maven counterpart of the Gradle plugin in ../gradle: the same two halves, the same skill names,
  the same report file and the same agent skills, so the lightweight codex cannot tell which build
  system a project uses. A build root of its own (ADR-0005), built and released alone.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.dependencyskills.maven</groupId>
    <artifactId>dependency-skills-maven-plugin</artifactId>
    <version>0.0.1</version>
    <packaging>maven-plugin</packaging>

    <name>Dependency Skills Maven Plugin</name>
    <description>
        Ships a library's own agent skill in its sources jar, reports a consuming project's dependencies
        for the lightweight codex, and writes the librarian and to-library-skill agent skills into a
        project whose build asks for them.
    </description>
    <licenses>
        <license>
            <name>Apache-2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <prerequisites>
        <maven>3.9.0</maven>
    </prerequisites>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>17</maven.compiler.release>
        <!-- The oldest Maven this runs in; Maven 4 runs 3.x plugins too. -->
        <maven.version>3.9.16</maven.version>
        <plugin.tools.version>3.16.0</plugin.tools.version>
    </properties>

    <dependencies>
        <!-- Provided by the Maven that runs the plugin, never shipped with it. -->
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${maven.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${maven.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>${plugin.tools.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- The one runtime dependency: reading and writing dependencyskills-lock.json. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.22.3</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!--
              The agent skills the plugin writes into a project that asks for them, carried in the jar from
              their one source in implementations/agent-skills/, so a plugin version and the skills it writes
              never drift apart. scripts/ never travels: a skill this plugin writes gives an agent nothing to run.
            -->
            <resource>
                <directory>${project.basedir}/../agent-skills</directory>
                <targetPath>org/dependencyskills/maven/skills</targetPath>
                <includes>
                    <include>librarian/**</include>
                    <include>to-library-skill/**</include>
                </includes>
                <excludes>
                    <exclude>**/scripts/**</exclude>
                </excludes>
            </resource>
        </resources>

        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <plugin>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.4.0</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <artifactId>maven-plugin-plugin</artifactId>
                <version>${plugin.tools.version}</version>
                <configuration>
                    <goalPrefix>dependency-skills</goalPrefix>
                </configuration>
            </plugin>
            <!--
              Real builds, run against the plugin as installed: a library whose sources jar must carry its
              skill, and a consumer whose report and skills must land. Each project in src/it is a build.
            -->
            <plugin>
                <artifactId>maven-invoker-plugin</artifactId>
                <version>3.10.1</version>
                <configuration>
                    <cloneProjectsTo>${project.build.directory}/it</cloneProjectsTo>
                    <localRepositoryPath>${project.build.directory}/it-repo</localRepositoryPath>
                    <settingsFile>src/it/settings.xml</settingsFile>
                    <postBuildHookScript>verify</postBuildHookScript>
                    <streamLogsOnFailures>true</streamLogsOnFailures>
                    <goals>
                        <goal>install</goal>
                    </goals>
                </configuration>
                <executions>
                    <execution>
                        <id>integration-test</id>
                        <goals>
                            <goal>install</goal>
                            <goal>run</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
